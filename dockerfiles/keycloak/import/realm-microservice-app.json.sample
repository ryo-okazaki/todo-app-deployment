{
  "realm": "microservice-app",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "rememberMe" : true,
  "verifyEmail" : true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,

  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "accessCodeLifespan": 60,

  "smtpServer" : {
    "replyToDisplayName" : "",
    "starttls" : "false",
    "auth" : "",
    "port" : "${MAIL_PORT}",
    "host" : "${MAIL_HOST}",
    "replyTo" : "",
    "from" : "${MAIL_FROM}",
    "fromDisplayName" : "Microservice App",
    "envelopeFrom" : "",
    "ssl" : "false"
  },

  "users": [],

  "clients": [
    {
      "clientId": "todo-backend-client",
      "name": "ToDo Backend Client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${TODO_BACKEND_SECRET}",
      "redirectUris": ["/*"],
      "webOrigins": ["/*"],
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    },
    {
      "clientId": "todo-frontend-client",
      "name": "ToDo Frontend Client",
      "rootUrl": "${TODO_FRONTEND_URL}",
      "adminUrl": "${TODO_FRONTEND_URL}",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["${TODO_FRONTEND_URL}/*"],
      "webOrigins": ["${TODO_FRONTEND_URL}"],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email",
        "todo-backend-audience"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "organization",
        "microprofile-jwt"
      ]
    }
  ],

  "clientScopes": [
    {
      "name": "todo-backend-audience",
      "description": "Audience mapper for backend",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false",
        "gui.order": "",
        "consent.screen.text": ""
      },
      "protocolMappers": [
        {
          "name": "todo-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "todo-backend-client",
            "id.token.claim": "false",
            "lightweight.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "false"
          }
        }
      ]
    }
  ],

  "roles": {
    "realm": [],
    "client": {}
  },

  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "updateProfileFirstLoginMode": "on",
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "hideOnLogin": false,
      "config": {
        "offlineAccess": "false",
        "acceptsPromptNoneForwardFromClient": "false",
        "clientId": "${GOOGLE_IDP_CLIENT_ID}",
        "disableUserInfo": "false",
        "filteredByClaim": "false",
        "syncMode": "IMPORT",
        "clientSecret": "${GOOGLE_IDP_CLIENT_SECRET}",
        "caseSensitiveOriginalUsername": "false",
        "prompt": "select_account",
        "defaultScope": "openid"
      }
    }
  ]
}
